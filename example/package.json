{
  "name": "react-native-camera-kit-example",
  "description": "CameraKit example for iOS, Android and macOS",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "lint": "eslint .",
    "start": "react-native start",
    "reverse": "adb reverse tcp:8081 tcp:8081",
    "macos": "RN_PLATFORM=macos react-native run-macos --mode Debug",
    "build:macos": "RN_PLATFORM=macos react-native build-macos --mode Debug",
    "pods:ios": "cd ios && pod install",
    "pods:macos": "cd macos && pod install",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-image-picker": "^7.1.2",
    "react-native-macos": "0.83.0",
    "react-native-camera-kit-no-google": "link:../"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.0.0",
    "@react-native-community/cli-platform-android": "20.0.0",
    "@react-native-community/cli-platform-ios": "20.0.0",
    "@react-native/babel-preset": "0.83.10",
    "@react-native/eslint-config": "0.83.10",
    "@react-native/metro-config": "0.83.10",
    "@react-native/typescript-config": "0.83.10",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.2.0",
    "eslint": "^8.19.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.0",
    "typescript": "^5.8.3",
    "@react-native-community/cli-platform-apple": "20.0.0"
  },
  "engines": {
    "node": ">=20.19.4"
  },
  "packageManager": "yarn@1.22.22"
}
